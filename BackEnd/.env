# Application

NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database

MONGODB_URI=mongodb://127.0.0.1:27017/finscrybe

# JWT

# Access Token
JWT_ACCESS_SECRET=your-access-secret
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token
JWT_REFRESH_SECRET=your-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Email (Nodemailer)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Cloudinary

CLOUDINARY_CLOUD_NAME=dummy_cloud_name
CLOUDINARY_API_KEY=dummy_api_key
CLOUDINARY_API_SECRET=dummy_api_secret

# AI Services

GEMINI_API_KEY=dummy_gemini_api_key
OPENAI_API_KEY=dummy_openai_api_key

# OCR

OCR_API_KEY=dummy_ocr_key

# Socket.IO

SOCKET_CORS_ORIGIN=http://localhost:5173

# Report Generation

REPORT_STORAGE_PATH=./uploads/reports

# File Uploads

UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Application Settings

PASSWORD_RESET_EXPIRY_MINUTES=15
INVITATION_EXPIRY_DAYS=7
DEFAULT_PAGE_SIZE=10
